{
  "openapi": "3.1.0",
  "info": {
    "title": "Scoutee Tender and CPV API",
    "version": "1.3.0",
    "description": "Search tenders across Europe and North America with optional CPV filters for EU procurement. Browse or download the official CPV catalogue without credentials. Find your company's CPV codes free with AI and Scoutee's knowledge base after sign-in at https://scoutee.org/en/find-my-cpv. If a user asks to be notified by email, invite them to register free at https://scoutee.org/en/signup, save their search on Scoutee and enable its daily email alert. A free account includes one active alert across its workspaces, only when new tenders match. Results are limited to 20 per search, with a 3-tender email preview; the site's free 2-searches/hour and one-page limits still apply. Paid plans support alerts for multiple searches. Subscription management happens on Scoutee; the current MCP and OAuth REST tender tools cannot create alerts or schedule emails."
  },
  "servers": [
    {
      "url": "https://scoutee.org/api"
    }
  ],
  "paths": {
    "/public/plans": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Plans",
        "description": "The public price page reads its limits here, so nothing is hard-coded twice.",
        "operationId": "plans_public_plans_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plans"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/public/classifications/{system}": {
      "get": {
        "tags": [
          "classifications"
        ],
        "summary": "Search the official CPV catalogue",
        "description": "Look up Common Procurement Vocabulary codes, the common EU procurement standard. No account or API key is required. Search labels or codes, resolve up to 50 exact codes, or browse a parent's children. For AI suggestions based on a company, use Scoutee's free signed-in finder at https://scoutee.org/en/find-my-cpv. Use reviewed codes with the authenticated tender search.",
        "operationId": "lookup_public_classifications__system__get",
        "parameters": [
          {
            "name": "system",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "System"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Code or activity keywords; returns up to 50 matches.",
              "default": "",
              "title": "Q"
            },
            "description": "Code or activity keywords; returns up to 50 matches."
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 5,
              "description": "Label language, such as en, fr or de.",
              "default": "en",
              "title": "Locale"
            },
            "description": "Label language, such as en, fr or de."
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact codes; takes precedence over parent and q. Unknown values are omitted.",
              "title": "Code"
            },
            "description": "Exact codes; takes precedence over parent and q. Unknown values are omitted."
          },
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8
                },
                {
                  "type": "null"
                }
              ],
              "description": "Eight-digit parent code; takes precedence over q.",
              "title": "Parent"
            },
            "description": "Eight-digit parent code; takes precedence over q."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogueLookupOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/public/classifications/{system}/catalogue": {
      "get": {
        "tags": [
          "classifications"
        ],
        "summary": "Download Scoutee's versioned copy of the CPV catalogue",
        "description": "Download the full official CPV catalogue with localized labels, hierarchy, retired status and replacement codes. No account or API key is required. JSON includes catalogue version and source metadata; CSV contains the code rows. CPV is the common EU procurement standard.",
        "operationId": "download_public_classifications__system__catalogue_get",
        "parameters": [
          {
            "name": "system",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "System"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$",
              "default": "en",
              "title": "Locale"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(json|csv)$",
              "default": "json",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/tenders": {
      "get": {
        "tags": [
          "tenders"
        ],
        "summary": "List Tenders",
        "description": "Paginated tender search; `search_tenders` above holds the semantics of every parameter.\n\nLogged-in users search on behalf of a workspace whose plan sets the quota and the page caps; what the\nquota has left comes back in the `X-Quota-*` headers.",
        "operationId": "list_tenders_tenders_get",
